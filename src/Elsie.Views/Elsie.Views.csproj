<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Fluid (Liquid) HTML views for Elsie — layouts, partials, HTML-encoding, IElsieViewEngine.</Description>
    <RootNamespace>Elsie.Views</RootNamespace>
    <AssemblyName>Elsie.Views</AssemblyName>
    <PackageId>Elsie.Views</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Elsie\Elsie.csproj" />
    <PackageReference Include="Fluid.ViewEngine" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" VersionOverride="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
  </ItemGroup>
</Project>
