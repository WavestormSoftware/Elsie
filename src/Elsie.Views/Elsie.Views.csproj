<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Minimal HTML file templates and layouts for Elsie ({{tokens}}, @layout).</Description>
    <RootNamespace>Elsie.Views</RootNamespace>
    <AssemblyName>Elsie.Views</AssemblyName>
    <PackageId>Elsie.Views</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Elsie\Elsie.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>
</Project>
