<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>In-process test host helpers for Elsie applications.</Description>
    <RootNamespace>Elsie.Testing</RootNamespace>
    <AssemblyName>Elsie.Testing</AssemblyName>
    <PackageId>Elsie.Testing</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Elsie.AspNetCore\Elsie.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="9.0.0" />
  </ItemGroup>
</Project>
