<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>In-process test hosts for Elsie (in-memory core + ASP.NET TestServer).</Description>
    <RootNamespace>Elsie.Testing</RootNamespace>
    <AssemblyName>Elsie.Testing</AssemblyName>
    <PackageId>Elsie.Testing</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Elsie\Elsie.csproj" />
    <ProjectReference Include="..\Elsie.AspNetCore\Elsie.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" VersionOverride="8.0.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" VersionOverride="10.0.0" />
  </ItemGroup>
</Project>
