<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>FluentValidation helpers for Elsie — BindAndValidateJsonAsync and DI registration.</Description>
    <RootNamespace>Elsie.FluentValidation</RootNamespace>
    <AssemblyName>Elsie.FluentValidation</AssemblyName>
    <PackageId>Elsie.FluentValidation</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Elsie\Elsie.csproj" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>
</Project>
