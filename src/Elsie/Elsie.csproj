<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Host-agnostic HTTP modules, routing, results, auth hooks, and OpenAPI document builder for Elsie.</Description>
    <RootNamespace>Elsie</RootNamespace>
    <AssemblyName>Elsie</AssemblyName>
    <PackageId>Elsie</PackageId>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>
</Project>
