<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Host-agnostic HTTP modules, routing, results, auth hooks, and OpenAPI document builder for Elsie. Apps normally reference the Elsie meta-package instead.</Description>
    <RootNamespace>Elsie</RootNamespace>
    <AssemblyName>Elsie</AssemblyName>
    <PackageId>Elsie.Core</PackageId>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" VersionOverride="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
</Project>
