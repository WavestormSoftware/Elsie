<Project Sdk="Microsoft.NET.Sdk">
  <!--
    App-facing meta-package (PackageId = Elsie).
    `dotnet add package Elsie` → depends on Elsie.Web → Elsie.Core.

    Ships a tiny marker assembly so nuget.org shows net8.0 / net10.0 frameworks
    (dependency-only packages with no lib/ often hide TFMs in the gallery UI).
  -->
  <PropertyGroup>
    <Description>
      Elsie — Sinatra-style HTTP modules for .NET 8 and .NET 10.
      Install this package to get the full host (Elsie.Web) and core framework (Elsie.Core).
    </Description>
    <PackageId>Elsie</PackageId>
    <RootNamespace>Elsie</RootNamespace>
    <AssemblyName>Elsie.Meta</AssemblyName>
    <PackageTags>Elsie;web-framework;HTTP;Sinatra;modules;routing;lightweight</PackageTags>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elsie.Web\Elsie.Web.csproj" PrivateAssets="none" />
  </ItemGroup>
</Project>
