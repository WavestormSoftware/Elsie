<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Elsie HTTP host — ElsieApp, HTTP/1.1 server, static files, OpenAPI routes.</Description>
    <RootNamespace>Elsie.Web</RootNamespace>
    <AssemblyName>Elsie.Web</AssemblyName>
    <PackageId>Elsie.Web</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Elsie\Elsie.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" VersionOverride="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Elsie.Web.Tests" />
  </ItemGroup>
</Project>
