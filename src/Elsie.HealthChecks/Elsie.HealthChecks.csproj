<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Host-agnostic health check module for Elsie (/healthz, /live, /ready).</Description>
    <RootNamespace>Elsie.HealthChecks</RootNamespace>
    <AssemblyName>Elsie.HealthChecks</AssemblyName>
    <PackageId>Elsie.HealthChecks</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Elsie\Elsie.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="8.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
