<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Host-agnostic HTTP modules, routing, results, auth hooks, and OpenAPI document builder for Elsie. Apps normally reference the Elsie host package instead.</Description>
    <RootNamespace>Elsie</RootNamespace>
    <AssemblyName>Elsie</AssemblyName>
    <PackageId>Elsie.Core</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Elsie.Tests" />
  </ItemGroup>
</Project>
