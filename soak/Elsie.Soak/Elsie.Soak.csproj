<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <RootNamespace>Elsie.Soak</RootNamespace>
    <AssemblyName>Elsie.Soak</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Standalone soak/stress harness: explicitly NOT part of Elsie.sln so CI's
         `dotnet test Elsie.sln` never picks it up. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Elsie\Elsie.csproj" />
    <ProjectReference Include="..\..\src\Elsie.Core\Elsie.Core.csproj" />
  </ItemGroup>

</Project>