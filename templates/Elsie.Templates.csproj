<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Elsie.Templates</PackageId>
    <Version>0.2.0-alpha.2</Version>
    <Authors>WavestormSoftware</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/WavestormSoftware/Elsie</PackageProjectUrl>
    <RepositoryUrl>https://github.com/WavestormSoftware/Elsie</RepositoryUrl>
    <PackageTags>Elsie;dotnet-new;templates</PackageTags>
    <Title>Elsie Templates</Title>
    <Description>dotnet new templates for Elsie (elsie, elsie-api).</Description>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IsPackable>true</IsPackable>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Templates are not multi-TFM library code. -->
    <TargetFrameworks></TargetFrameworks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="elsie\**\*" Exclude="elsie\**\bin\**;elsie\**\obj\**" />
    <Content Include="elsie-api\**\*" Exclude="elsie-api\**\bin\**;elsie-api\**\obj\**" />
    <Compile Remove="**\*" />
    <EmbeddedResource Remove="**\*" />
    <None Remove="**\*" />
  </ItemGroup>
</Project>
